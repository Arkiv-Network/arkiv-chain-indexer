#!/usr/bin/env bash

set -euo pipefail

SITE_NAME="${SITE_NAME:-scanner.arkiv-global.net}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_SOURCE="${CONFIG_SOURCE:-${REPO_ROOT}/${SITE_NAME}}"
SITES_AVAILABLE="${SITES_AVAILABLE:-/etc/nginx/sites-available}"
SITES_ENABLED="${SITES_ENABLED:-/etc/nginx/sites-enabled}"
SUDO=()

if [[ "${EUID}" -ne 0 ]]; then
  SUDO=(sudo)
fi

if [[ ! -f "${CONFIG_SOURCE}" ]]; then
  echo "nginx config not found: ${CONFIG_SOURCE}" >&2
  exit 1
fi

"${SUDO[@]}" install -m 0644 "${CONFIG_SOURCE}" "${SITES_AVAILABLE}/${SITE_NAME}"
"${SUDO[@]}" ln -sfn "${SITES_AVAILABLE}/${SITE_NAME}" "${SITES_ENABLED}/${SITE_NAME}"
"${SUDO[@]}" nginx -t

echo "Installed ${SITE_NAME}. Run certbot after confirming the site is reachable."
