# Required: Ethereum JSON-RPC endpoint used by the scanner container.
SCANNER_RPC_FULL_NODE=https://mainnet.rpc-node.dev.golem.network/

# Optional: API key sent as X-Api-Key with every scanner RPC request. Needed on
# Arkiv gateway endpoints whose anonymous quota (RateLimit header) is too low
# for continuous scanning.
# SCANNER_RPC_API_KEY=

# Optional Docker build input: Arkiv JS SDK branch, tag, or commit used when
# building the scanner/backend image.
ARKIV_JS_SDK=develop

# Optional scanner tuning.
# Master switch for historical backfill. The scanner container always scans
# forward only; backfill runs in the separate backfill-scanner container. When
# this is true (the default) the backfill-scanner idles and does nothing. Set it
# to false to run the historical backfill.
# SCANNER_DISABLE_BACKFILL=true
# Backfill-scanner tuning (ignored while SCANNER_DISABLE_BACKFILL=true).
# SCANNER_OLDEST_BACKFILL_BLOCK=25000000
# Delay after each successful historical backfill block.
# SCANNER_BACKFILL_SLEEP_MS=100
# SCANNER_CONFIRMATION_DEPTH=3
# SCANNER_POLL_MS=2000
# SCANNER_RETRY_MS=5000
# Receipts are fetched sequentially; this legacy setting is accepted for compatibility.
# SCANNER_TX_RECEIPT_CONCURRENCY=20
# Gap-filler tuning. The gap-filler re-scans internal holes in the stored block
# sequence; these bound its RPC load and per-block retry behaviour.
# GAP_FILL_INTERVAL_MS=60000
# GAP_FILL_MAX_BLOCKS_PER_CYCLE=500
# GAP_FILL_BLOCK_SLEEP_MS=50
# GAP_FILL_RETRY_MS=5000
# GAP_FILL_MAX_RETRIES=5

# Optional: batcher collector base URL. When set, the batcher-collector
# compose service stores recent per-block batcher queue/threshold fields for
# blocks already written by the scanner.
# BATCHER_COLLECTOR_URL=https://batcher-collector.example
# BATCHER_COLLECTOR_INTERVAL_MS=10000
# Set to true to store and expose per-transaction rows. The normal Docker stack
# defaults this to false; the Arkiv test stack defaults it to true.
# SAVE_TRANSACTION_DATA=false
# Optional: arkiv-transaction-decoder base URL. When set (and transaction rows
# are stored), Arkiv registry transactions are decoded and operation metadata is
# stored in transaction_operations — payloads/calldata are never persisted. Under
# v1 reference mode, create/update ops carry a signed provider reference
# (contentType application/vnd.atlas.payload-reference+json); the scanner also
# stores that reference's receipt metadata and the decoder's offline EIP-191
# verification verdict (still never the entity bytes). Docker Compose defaults
# this to the bundled decoder service on port 28884. Set it empty (DECODER_URL=)
# to disable decoding. For non-Docker local runs point it at a locally running
# decoder, e.g. http://127.0.0.1:28884.
# DECODER_URL=http://decoder:28884
# The scanner probes eth_chainId once at startup and sends it with each decode
# request, for a decoder that verifies payload references against a per-chain
# trusted-signer allowlist. arkiv-transaction-decoder v0.2.0 does not parse
# references at all — it ignores the chain id, and the reference columns stay
# unset — so DECODER_DEFAULT_CHAIN_ID and TRUSTED_PROVIDER_SIGNERS, which
# configured the previous decoder, are gone from docker-compose.yml.
# Optional backend schedule source used by /transaction/<hash> to split signed
# payload-reference payments into provider-earned and burned native token.
# Use the same schedule URL/path that arkiv-node uses when available.
# ARKIV_PROTOCOL_SCHEDULE_URL=http://protocol-schedule:8080/atlas-protocol-schedule.json
# ARKIV_PROTOCOL_SCHEDULE_PATH=
# Optional local override for the provider share in basis points when no schedule
# is configured. 7000 means 70.00% to the recovered provider signer and 30.00% burned.
# PAYLOAD_PROVIDER_PAYMENT_SHARE_BPS=7000

# Redis connection used by the database-free "guzzlers" feature: the near-head
# scanner aggregates each sender's activity into one-minute buckets (retained 24h)
# in Redis and, once a minute, caches the top-250 leaderboards that the backend
# serves at GET /guzzlers. Defaults to the bundled compose redis service.
# REDIS_URL=redis://redis:6379

# Entity history endpoint tuning. GET /entity/<key> returns the newest
# ENTITY_HISTORY_LIMIT operations (with the total count and, when truncated,
# the earliest stored operation) and serves responses from a bounded in-memory
# cache invalidated by scanner writes (Postgres NOTIFY) with a TTL backstop.
# Setting any cache knob to 0 disables the cache.
# ENTITY_HISTORY_LIMIT=100
# ENTITY_CACHE_MAX_ENTRIES=10000
# ENTITY_CACHE_MAX_BYTES=67108864
# ENTITY_CACHE_TTL_MS=300000

# Aggregator runs every supported range size in a loop. Default sleep after
# each sweep is 30 seconds.
# AGGREGATE_INTERVAL_MS=30000

# Sender aggregator rebuilds address-level stats from stored transactions.
# Default sleep between rebuilds is one minute.
# SENDER_AGGREGATE_INTERVAL_MS=60000

# Optional backend Baseload worker settings. BASELOAD_RPC_NODE is the JSON-RPC
# endpoint used for Arkiv create transactions. Leave BASELOAD_MNEMONIC unset to
# use the deterministic development mnemonic baked into the backend.
# BASELOAD_RPC_NODE=https://braga.hoodi.arkiv.network/rpc
# BASELOAD_MNEMONIC="parent picture garment parrot churn record stadium pill rocket craft fish fiscal clip virus view diary replace wealth extra kitten door enforce piece nut"
# Baseload create/update operations require a payload provider. Set the bearer
# key when the provider requires Authorization: Bearer <token> for submissions.
# BASELOAD_PAYLOAD_PROVIDER_URL=http://payload-provider:28883
# BASELOAD_PAYLOAD_PROVIDER_BEARER_KEY=
# BASELOAD_PAYLOAD_PROVIDER_NAMESPACE=arkiv.entities
# BASELOAD_PAYLOAD_PROVIDER_VERIFY_RECEIPT=true
# Auto-faucet: keeps worker wallets funded from the network's internal faucet.
# Setting the URL enables it and makes the password mandatory. Wallets are dripped
# once they fall below MIN_BALANCE, and never when the drip would land them at or
# above MAX_BALANCE. Amounts are in ether.
# Drips repeat until a wallet is back over MIN_BALANCE, so the floor — not the
# ceiling — sets where wallets come to rest: [MIN_BALANCE, MIN_BALANCE + DRIP_AMOUNT).
# With the defaults below an empty wallet is topped up to 100 and never holds 200 or
# more. MAX_BALANCE is a safety net and must be at least MIN_BALANCE + DRIP_AMOUNT.
# BASELOAD_FAUCET_URL=https://internal-faucet.scx1.db-chain.devnet.gobas.me
# BASELOAD_FAUCET_PASSWORD=
# BASELOAD_FAUCET_MIN_BALANCE=100
# BASELOAD_FAUCET_MAX_BALANCE=200
# BASELOAD_FAUCET_DRIP_AMOUNT=100
# BASELOAD_FAUCET_COOLDOWN_SECONDS=60
# Set this in shared deployments to require Authorization: Bearer <token> for
# Baseload worker changes. Readonly tabs and API routes remain public.
# BASELOAD_ADMIN_BEARER_TOKEN=
# Optional initial Baseload worker config for Docker Compose. Put config.json
# in BASELOAD_CONFIG_DIR on the host; the backend reads the mounted file once
# at startup when BASELOAD_INITIAL_CONFIG_PATH is set.
# BASELOAD_CONFIG_DIR=/absolute/path/to/generated-baseload-config
# BASELOAD_INITIAL_CONFIG_PATH=/app/baseload-config/config.json

# Per-worker RPC keys (Arkiv-Network/api-key-generator). Set the service URL to
# hand every Baseload worker its own generated key, so the fleet stops sharing a
# single key's rate-limit bucket -- that shared bucket, not the chain, is what
# caps throughput past ~6 workers. Also add COMPOSE_PROFILES=rpc-keys so the
# generator container starts, and drop any key baked into BASELOAD_RPC_NODE.
# The generator mints Arkiv Hub keys (devnet.hub.arkiv.network); a per-network
# bouncer such as rpc.<net>.db-chain.devnet.gobas.me does NOT accept them -- it
# only knows keys minted through its own rpc-control endpoint.
# COMPOSE_PROFILES=rpc-keys
# BASELOAD_RPC_KEY_SERVICE_URL=http://arkiv-keys:8787
# How the key is attached: bearer (default, what the Hub proxy wants), header
# (BASELOAD_RPC_KEY_HEADER, default X-Api-Key), or path (last URL segment).
# BASELOAD_RPC_KEY_PLACEMENT=bearer
# BASELOAD_RPC_KEY_HEADER=X-Api-Key
# Keys are requested as <prefix>_<worker id> and cached in the store file, which
# lives on the baseloadkeys volume so restarts reuse them (each mint is a captcha
# solve and takes tens of seconds).
# BASELOAD_RPC_KEY_NAME_PREFIX=baseload
# BASELOAD_RPC_KEY_STORE=/app/baseload-keys/rpc-keys.json
# BASELOAD_RPC_KEY_TIMEOUT_SECONDS=180

# Frontend build-time page settings. These are passed to Vite through the
# frontend Docker build and require rebuilding the frontend image after changes.
VITE_CHAIN_NAME=Arkiv
VITE_TOKEN_SYMBOL=ETH
VITE_TRANSACTION_EXPLORER_BASE_URL=https://explorer.braga.hoodi.arkiv.network/tx/
# Base URL of the payload provider; the transaction view deep-links each payload
# reference id to <base>/payloads/<id> for the payload's info. Defaults to
# https://payload.atlas.arkiv-global.net when unset.
VITE_PAYLOAD_PROVIDER_BASE_URL=https://payload.atlas.arkiv-global.net
VITE_BLOCK_TIME_MS=2000
VITE_STUB_TICK_MS=500
VITE_MAX_STUB_BLOCKS=3
VITE_STUB_VISIBLE_AGE_MS=6000
VITE_PING_START_AGE_MS=9000
VITE_LOADING_METADATA_LEAD_MS=1000
VITE_NEXT_BLOCK_PING_MS=100
VITE_PING_MIN_INTERVAL_MS=1500
VITE_SCANNER_DELAY_WARNING_AGE_MS=60000
VITE_HISTOGRAM_WINDOW_MINUTES=60
VITE_HISTOGRAM_REFRESH_MS=5000
VITE_HISTOGRAM_CLOCK_TICK_MS=1000
# Set to true for networks without batcher metrics; hides batcher panels and chart options.
VITE_NO_BATCHER=false

# PostgreSQL credentials. Override for prod-ish deployments.
POSTGRES_USER=gas
POSTGRES_PASSWORD=gas
POSTGRES_DB=gas

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=23560
