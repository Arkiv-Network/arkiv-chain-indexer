# Required: Ethereum JSON-RPC endpoint used by the scanner container.
SCANNER_RPC_FULL_NODE=https://mainnet.rpc-node.dev.golem.network/

# Optional: limit the scan to a fixed block window. Leave unset for continuous
# near-head + backfill scanning.
# SCANNER_FROM_BLOCK=19000000
# SCANNER_TO_BLOCK=19000010

# Optional scanner tuning.
# SCANNER_OLDEST_BACKFILL_BLOCK=25000000
# The compose scanner service defaults this to true because backfill runs in
# the separate backfill-scanner service.
# SCANNER_DISABLE_BACKFILL=true
# Delay after each successful historical backfill block.
# SCANNER_BACKFILL_SLEEP_MS=100
# SCANNER_CONFIRMATION_DEPTH=3
# SCANNER_POLL_MS=2000
# SCANNER_RETRY_MS=5000
# Receipts are fetched sequentially; this legacy setting is accepted for compatibility.
# SCANNER_TX_RECEIPT_CONCURRENCY=20
# Optional: batcher collector base URL. When set, the batcher-collector
# compose service stores recent per-block batcher queue/threshold fields for
# blocks already written by the scanner.
# BATCHER_COLLECTOR_URL=https://batcher-collector.example
# BATCHER_COLLECTOR_INTERVAL_MS=10000
# Set to true to store and expose per-transaction rows. The normal Docker stack
# defaults this to false; the Arkiv test stack defaults it to true.
# SAVE_TRANSACTION_DATA=false

# Aggregator runs every supported range size in a loop. Default sleep between
# sweeps is one minute.
# AGGREGATE_INTERVAL_MS=60000

# Sender aggregator rebuilds address-level stats from stored transactions.
# Default sleep between rebuilds is one minute.
# SENDER_AGGREGATE_INTERVAL_MS=60000

# Optional backend Baseload worker settings. BASELOAD_RPC_NODE is the JSON-RPC
# endpoint used for Arkiv create transactions. Leave BASELOAD_MNEMONIC unset to
# use the deterministic development mnemonic baked into the backend.
# BASELOAD_RPC_NODE=https://braga.hoodi.arkiv.network/rpc
# BASELOAD_MNEMONIC="parent picture garment parrot churn record stadium pill rocket craft fish fiscal clip virus view diary replace wealth extra kitten door enforce piece nut"
# Set this in shared deployments to require Authorization: Bearer <token> for
# Baseload worker changes. Readonly tabs and API routes remain public.
# BASELOAD_ADMIN_BEARER_TOKEN=

# Canonical public portal URL used by deployment docs/configuration.
PORTAL_BASE_URL=https://scanner.arkiv-global.net

# PostgreSQL credentials. Override for prod-ish deployments.
POSTGRES_USER=gas
POSTGRES_PASSWORD=gas
POSTGRES_DB=gas

# Host addresses and ports exposed by the compose stack. Host bindings default
# to loopback so nginx can publish the public site without exposing containers
# directly on all interfaces.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=23560
