FROM node:22-alpine AS build
# Mirror the repository layout: the UI lives in frontend/ and imports shared
# modules from ../src (see frontend/src/searchApi.ts), so the build stage keeps
# the same relative paths as the checkout.
WORKDIR /repo/frontend

ARG VITE_CHAIN_NAME=Arkiv
ARG VITE_NETWORK_NAME=
ARG VITE_TOKEN_SYMBOL=ETH
ARG VITE_TRANSACTION_DECODER_BASE_URL=https://decoder.atlas.arkiv-global.net/
ARG VITE_TRANSACTION_EXPLORER_BASE_URL=
ARG VITE_BLOCK_TIME_MS=2000
ARG VITE_STUB_TICK_MS=500
ARG VITE_MAX_STUB_BLOCKS=3
ARG VITE_STUB_VISIBLE_AGE_MS=6000
ARG VITE_PING_START_AGE_MS=9000
ARG VITE_LOADING_METADATA_LEAD_MS=1000
ARG VITE_NEXT_BLOCK_PING_MS=100
ARG VITE_PING_MIN_INTERVAL_MS=1500
ARG VITE_SCANNER_DELAY_WARNING_AGE_MS=60000
ARG VITE_HISTOGRAM_WINDOW_MINUTES=60
ARG VITE_HISTOGRAM_REFRESH_MS=5000
ARG VITE_HISTOGRAM_CLOCK_TICK_MS=1000
ARG VITE_NO_BATCHER=false

ENV VITE_CHAIN_NAME=$VITE_CHAIN_NAME
ENV VITE_NETWORK_NAME=$VITE_NETWORK_NAME
ENV VITE_TOKEN_SYMBOL=$VITE_TOKEN_SYMBOL
ENV VITE_TRANSACTION_DECODER_BASE_URL=$VITE_TRANSACTION_DECODER_BASE_URL
ENV VITE_TRANSACTION_EXPLORER_BASE_URL=$VITE_TRANSACTION_EXPLORER_BASE_URL
ENV VITE_BLOCK_TIME_MS=$VITE_BLOCK_TIME_MS
ENV VITE_STUB_TICK_MS=$VITE_STUB_TICK_MS
ENV VITE_MAX_STUB_BLOCKS=$VITE_MAX_STUB_BLOCKS
ENV VITE_STUB_VISIBLE_AGE_MS=$VITE_STUB_VISIBLE_AGE_MS
ENV VITE_PING_START_AGE_MS=$VITE_PING_START_AGE_MS
ENV VITE_LOADING_METADATA_LEAD_MS=$VITE_LOADING_METADATA_LEAD_MS
ENV VITE_NEXT_BLOCK_PING_MS=$VITE_NEXT_BLOCK_PING_MS
ENV VITE_PING_MIN_INTERVAL_MS=$VITE_PING_MIN_INTERVAL_MS
ENV VITE_SCANNER_DELAY_WARNING_AGE_MS=$VITE_SCANNER_DELAY_WARNING_AGE_MS
ENV VITE_HISTOGRAM_WINDOW_MINUTES=$VITE_HISTOGRAM_WINDOW_MINUTES
ENV VITE_HISTOGRAM_REFRESH_MS=$VITE_HISTOGRAM_REFRESH_MS
ENV VITE_HISTOGRAM_CLOCK_TICK_MS=$VITE_HISTOGRAM_CLOCK_TICK_MS
ENV VITE_NO_BATCHER=$VITE_NO_BATCHER

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
# Shared backend/frontend modules come from a second build context named
# "shared" that points at the repository's src/ directory (docker-compose.yml
# build.additional_contexts, build-push-action build-contexts). A plain
# `docker build frontend` has no such context and fails on this line.
COPY --from=shared . /repo/src
COPY public ./public
COPY scripts ./scripts
RUN npm run build

FROM node:22-alpine
WORKDIR /app

COPY --from=build /repo/frontend/dist ./dist
COPY server.js ./

ENV NODE_ENV=production
ENV PORT=23560
EXPOSE 23560

CMD ["node", "server.js"]
